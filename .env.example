# Где работает приложение.
#   локально:    DOMAIN=:80                 и PUBLIC_URL=http://localhost
#   на сервере:  DOMAIN=app.ваш-домен.ru    и PUBLIC_URL=https://app.ваш-домен.ru  (A-запись → IP сервера)
DOMAIN=:80
# порты на компьютере; если 80 занят (nginx, IIS, другой контейнер) — поставьте 8080 и откройте http://localhost:8080
HTTP_PORT=80
HTTPS_PORT=443

ENV=dev
JWT_SECRET=change-me-long-random-string
ADMIN_TOKEN=change-me

# MAX
MAX_BOT_TOKEN=
# публичное имя бота (username) — для диплинков https://max.ru/<name>?startapp=... и кнопки open_app
MAX_BOT_NAME=t829_hakaton_max_bot
# в Docker бандл сертификатов НУЦ собирается в образе автоматически; для запуска без Docker —
# путь к бандлу certifi + сертификаты НУЦ
MAX_CA_BUNDLE=/app/ca-bundle.pem
# polling (разработка) | webhook (прод: PUBLIC_URL должен быть https на 443)
MAX_MODE=polling
# 5–256 символов A-Za-z0-9_-; MAX пришлёт его в заголовке X-Max-Bot-Api-Secret
MAX_WEBHOOK_SECRET=
# включить long polling внутри процесса (только MAX_MODE=polling)
MAX_POLLING_ENABLED=1
# удалить подписки на вебхук перед стартом polling (иначе polling не работает)
MAX_DROP_WEBHOOKS=1
# публичный адрес бэкенда: из него строятся ссылки /go/{id} в кнопках бота
PUBLIC_URL=http://localhost
FRONTEND_ORIGIN=http://localhost

# только для локальной разработки, на демо = 0
DEV_FAKE_AUTH=0

GIGA_AUTH_KEY=
GIGA_SCOPE=GIGACHAT_API_PERS
GIGA_CA_BUNDLE=
